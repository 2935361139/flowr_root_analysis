+def choose_active(items, routes, requested):
+    """Select requested failures and retain same-input passing controls."""
+    # Use the evaluator conjunction, not a route-name assumption.
+    failed={item['id'] for item in items if not successful(item['rows']['raw_without_repair'])}
+    if requested is None:
+        requested=failed
+    else:
+        require(isinstance(requested,list) and all(isinstance(x,str) for x in requested), 'Requested IDs must be a JSON list')
+        require(len(requested)==len(set(requested)), 'Duplicate requested failure IDs')
+        require(set(requested)<=failed, 'Requested ID is missing or is an original success')
+        requested=set(requested)
+    eligible_inputs={item['input_id'] for item in items if item['id'] in requested
+                     and routes[item['id']]['status']=='supported_geometry'}
+    selected=[item for item in items if item['input_id'] in eligible_inputs
+              and (item['id'] in requested or successful(item['rows']['raw_without_repair']))
+              and routes[item['id']]['status']!='unsupported']
+    return selected, requested
+
+
